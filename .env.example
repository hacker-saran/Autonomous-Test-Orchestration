# LLM provider config. Provider-agnostic names: the client is a plain
# OpenAI-SDK-compatible client, so these default to Sarvam (the intended
# production provider) but can point at any other OpenAI-compatible endpoint
# (e.g. Claude's or Gemini's compat layer) with no code changes.
LLM_API_KEY=
LLM_BASE_URL=https://api.sarvam.ai/v2
LLM_MODEL_PRIMARY=glm-5.2
LLM_MODEL_FALLBACK=sarvam-105b
CRAWL_MAX_DEPTH=3
CRAWL_MAX_PAGES=20
CRAWL_TIMEOUT_S=90
MAX_REPLAN_ITERATIONS=2
